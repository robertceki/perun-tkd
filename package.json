{
  "name": "perun-tkd-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext .ts,.tsx,.cjs --report-unused-disable-directives --max-warnings 0",
